# Ledgerline Environment Configuration

# ===== Provider API Keys =====
# Required for AI provider access
OPENAI_API_KEY=sk-proj-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# ===== Database Configuration =====
DATABASE_URL=postgres://ledgerline:ledgerline_dev_password@localhost:5432/ledgerline?sslmode=disable
POSTGRES_DB=ledgerline
POSTGRES_USER=ledgerline
POSTGRES_PASSWORD=ledgerline_dev_password

# ===== Redis Configuration =====
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=ledgerline_redis_password

# ===== RabbitMQ Configuration =====
RABBITMQ_URL=amqp://ledgerline:ledgerline_rabbit_password@localhost:15672/
RABBITMQ_DEFAULT_USER=ledgerline
RABBITMQ_DEFAULT_PASS=ledgerline_rabbit_password

# ===== Kong Configuration =====
KONG_PG_HOST=kong-database
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong_password
KONG_PG_DATABASE=kong

# ===== Service Ports =====
DISPATCHER_PORT=8000
RATE_LIMITER_PORT=8081
DLQ_HANDLER_PORT=8082
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
FRONTEND_PORT=3000

# ===== Qdrant Configuration =====
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ===== Observability =====
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_PORT=16686

# ===== Frontend API URL =====
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===== Development Settings =====
LOG_LEVEL=info
ENVIRONMENT=development
