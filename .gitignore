# Ledgerline .gitignore

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependencies
node_modules/
__pycache__/
*.py[cod]
*$py.class
venv/
env/
ENV/

# Build outputs
dist/
build/
*.exe
*.dll
*.so
*.dylib
bin/
obj/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Go
*.test
*.out
go.work

# Python
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# Frontend
.next/
out/
.cache/

# Database
*.db
*.sqlite
*.sqlite3

# Docker
docker-compose.override.yml

# Secrets and keys
*.key
*.pem
*.crt
vault_keys/
secrets/

# Temporary files
tmp/
temp/
*.tmp

# OS
Thumbs.db
.Spotlight-V100
.Trashes
